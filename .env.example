# Environment template (M14). Copy the values into your shell environment; never commit real values.
# The application does not read this file automatically.

# Dataset: synthetic (DEFAULT when unset; public, generated locally) | ims (owner only: licensed data)
PCI_DATASET=synthetic

# ims only: absolute path of the private IMS data directory, OUTSIDE this repository. Never commit a real value.
# PCI_IMS_DATA_DIR=<PRIVATE_EXTERNAL_DIRECTORY>

# ims only: private source workbook (only for rebuilding the private processed layer; outside the repository)
# PCI_SOURCE_PATH=

# Language model: NONE (default, offline, deterministic) | GEMINI (opt-in; requires PCI_DATASET=synthetic)
LLM_PROVIDER=NONE
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
