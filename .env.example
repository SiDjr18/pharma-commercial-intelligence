# Environment template (M14). Copy the values into your shell environment; never commit real values.
# The application does not read this file automatically.

# Dataset: private (default; needs the licensed processed layer) | synthetic (public, generated locally)
PCI_DATASET=synthetic

# Private source location on your machine (only for rebuilding the private processed layer)
# PCI_SOURCE_PATH=

# Language model: NONE (default, offline, deterministic) | GEMINI (opt-in; requires PCI_DATASET=synthetic)
LLM_PROVIDER=NONE
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
