  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Metric definitions",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#142231"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Value = Σ value (₹ crore, confirmed) over the window; Units/Qty = Σ '000 (inferred scale).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#384657"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Growth % = current / prior × 100 − 100, only when prior > 0. Otherwise BLANK with a reason (no prior sales, no sales, comparison window before the data). Never 0.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#384657"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Share of market = entity / market (current filters minus product and company). Share of total = national.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#384657"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Share change (pp) = current share − prior share. Units share uses units.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#384657"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Contribution (pp) = (current − prior) / market prior × 100; sums to market growth.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#384657"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Evolution index = share now / share a year ago × 100 (100 = kept pace).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#384657"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Rank = deterministic rank within the current selection (value rounded to 1e-9, ties by key).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#384657"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
